# navellier-replicator environment configuration
# Copy to `.env` (gitignored) and fill in. NEVER commit the real .env.

# --- InvestorPlace authenticated collection ---
INVESTORPLACE_USERNAME=
INVESTORPLACE_PASSWORD=
INVESTORPLACE_LOGIN_URL=https://investorplace.com/login/
INVESTORPLACE_PORTFOLIO_URL=

# --- Interactive Brokers (v0.3 only; paper mode is the ONLY supported mode) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=71
IBKR_ACCOUNT=

# --- Runtime ---
APP_ENV=dev

# Paths (optional overrides; sensible defaults are used if unset)
# NR_DATA_DIR=./data
# NR_DB_URL=sqlite:///./data/navellier.db
# NR_SETTINGS_FILE=./config/settings.yaml
# NR_SELECTORS_FILE=./config/selectors.yaml
